# --- MiniMax (TTS) ---
# Si no defines MINIMAX_API_KEY, se usa ANTHROPIC_AUTH_TOKEN del entorno.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.6-turbo
# Voces: Spanish_ConfidentWoman, Spanish_Jovialman, Spanish_CaptivatingStoryteller...
MINIMAX_VOICE_ID=Spanish_ConfidentWoman
MINIMAX_TTS_SAMPLE_RATE=24000
MINIMAX_TTS_SPEED=1.0

# --- STT (whisper.cpp local) ---
JARVIS_WHISPER_BIN=whisper-cli
# Ruta absoluta al modelo ggml. Descarga: scripts/fetch-model.sh
JARVIS_WHISPER_MODEL=
JARVIS_STT_LANGUAGE=es

# --- Captura de audio ---
# 0 = autocalibrar contra el ruido ambiente (recomendado).
JARVIS_SILENCE_THRESHOLD=0
JARVIS_SILENCE_DURATION=0.9
JARVIS_MAX_UTTERANCE=20
JARVIS_START_TIMEOUT=10

# --- Ejecución ---
# Motor que razona: llm (MiniMax M3 + tools locales), dry-run, openclaw
JARVIS_BACKEND=llm
# Habilita shell_command y open_app. Mantener en 0 hasta confiar en el agente.
JARVIS_ALLOW_DANGEROUS=0
JARVIS_OPENCLAW_BIN=openclaw
JARVIS_OPENCLAW_CWD=
JARVIS_OPENCLAW_MODEL=
JARVIS_OPENCLAW_TIMEOUT=180
